# /home/hermes/.hermes/profiles/sw-lead/loop-listener.env (chmod 600, owner hermes). No secret here:
# the secret lives in its own file, the same value as the org webhook's secret on GitHub.
LOOP_WEBHOOK_SECRET_FILE=/home/hermes/.hermes/profiles/sw-lead/loop-webhook.secret
LOOP_LISTEN_HOST=127.0.0.1
LOOP_LISTEN_PORT=8655
